{
 "manifest_version": 3,
 "name": "Jab",
 "version": "0.2.0",
 "permissions": [
  "offscreen"
 ],
 "background": {
  "service_worker": "background.js"
 },
 "content_scripts": [
  {
   "matches": [
    "<all_urls>"
   ],
   "js": [
    "content.js"
   ]
  }
 ],
 "content_security_policy": {
  "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
 },
 "cross_origin_embedder_policy": {
  "value": "require-corp"
 },
 "cross_origin_opener_policy": {
  "value": "same-origin"
 },
 "description": "Jev-style tab, not affiliated with Jev. Hold Q and press Tab: focus the control this page most likely wants next. A small model runs in your browser."
}
