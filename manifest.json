{
  "manifest_version": 3,
  "name": "jab",
  "version": "0.4.0",
  "background": {
    "service_worker": "jab.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["jab.js"],
      "all_frames": true
    }
  ],
  "description": "Ctrl+Q tabs to what you want next, powered by a local 2MB 2016 classifier"
}
