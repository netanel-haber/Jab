{
  "manifest_version": 3,
  "name": "jab",
  "version": "0.5.0",
  "background": {
    "service_worker": "jab.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["jab.js"],
      "all_frames": true
    }
  ],
  "description": "Ctrl+Q tabs to what you want next, using 2MB of decision trees from 2016",
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}
